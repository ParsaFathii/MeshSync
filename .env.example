# MeshSync agent runtime configuration (copy to .env and adjust)
# This file contains NO secrets. MeshSync peer trust is based on device key
# fingerprints exchanged during explicit pairing, not passwords.

# --- Web dashboard (Next.js) ---
# SQLite database used by the web layer for local UI preferences and the
# agent endpoint registry. The sync engine itself keeps its state in the
# agent databases below.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# --- MeshSync agent instances (local dev harness) ---
# Each agent is an independent process with its own state database,
# identity key, shared folder and ports.
MESHSYNC_A_API_PORT=3040
MESHSYNC_A_PEER_PORT=4040
MESHSYNC_A_NAME=mesh-alpha
MESHSYNC_B_API_PORT=3041
MESHSYNC_B_PEER_PORT=4041
MESHSYNC_B_NAME=mesh-beta
MESHSYNC_DATA_ROOT=/home/z/my-project/data
