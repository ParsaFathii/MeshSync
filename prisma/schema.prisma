generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AgentEndpoint {
  id        Int      @id @default(autoincrement())
  label     String   @unique
  port      Int      @unique
  createdAt DateTime @default(now())
}

model ClientPref {
  clientId  String   @id
  language  String?
  theme     String?
  updatedAt DateTime @updatedAt
}
